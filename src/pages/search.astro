---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection, getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
if (config.features.search === false) {
  return Astro.rewrite(getRelativeLocaleUrl(locale, "404"));
}
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
const t = useTranslations(locale);
// Keep article text searchable while removing Markdown and MDX markup from excerpts.
const plainText = (body = "") =>
  body
    .replace(/^import .*$/gm, " ")
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]*>/g, " ")
    .replace(/[`#*_~>|{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
const posts = getSortedPosts(await getCollection("posts"));
const about = await getEntry("pages", "about");
const documents = posts.map(post => ({
  title: post.data.title,
  description: post.data.description,
  body: plainText(post.body),
  url: getPostUrl(post.id, post.filePath, locale),
  meta: `${post.data.tags.slice(0, 3).join(" · ")} · ${Math.max(1, Math.ceil(plainText(post.body).split(/\s+/).length / 200))} min read`,
}));
if (about)
  documents.push({
    title: about.data.title,
    description: about.data.description ?? "",
    body: plainText(about.body),
    url: getRelativeLocaleUrl(locale, "about"),
    meta: "About",
  });
const searchData = JSON.stringify(documents).replace(/</g, "\\u003c");
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    <div id="orama-search" data-backurl={backUrl}>
      <div class="search-field">
        <svg
          class="search-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          ><circle cx="10.5" cy="10.5" r="7.5"></circle><path d="m16 16 5 5"
          ></path></svg
        >
        <label class="sr-only" for="search-input">{t.nav.search}</label>
        <input
          id="search-input"
          type="search"
          placeholder="What are you curious about?"
          autocomplete="off"
        />
        <button
          id="search-clear"
          type="button"
          aria-label="Clear search"
          hidden
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"><path d="M5 5l14 14M19 5 5 19"></path></svg
          >
        </button>
      </div>
      <div class="search-content">
        <p id="search-status" role="status"></p>
        <ul id="search-results"></ul>
      </div>
      <div class="search-footer">
        <span>Search the journal</span><a
          href="https://orama.com"
          target="_blank"
          rel="noopener noreferrer"
          >Powered by Orama <span aria-hidden="true">↗</span></a>
      </div>
      <script type="application/json" id="search-data" set:html={searchData} />
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import { create, insertMultiple, search } from "@orama/orama";

  async function initSearch() {
    const root = document.querySelector<HTMLElement>("#orama-search");
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = "true";
    const input = root.querySelector<HTMLInputElement>("#search-input")!;
    const results = root.querySelector<HTMLUListElement>("#search-results")!;
    const clear = root.querySelector<HTMLButtonElement>("#search-clear")!;
    const status = root.querySelector<HTMLElement>("#search-status")!;
    const data = JSON.parse(
      root.querySelector("#search-data")!.textContent || "[]"
    ) as {
      title: string;
      description: string;
      body: string;
      url: string;
      meta: string;
    }[];
    const db = create({
      schema: {
        title: "string",
        description: "string",
        body: "string",
        url: "string",
        meta: "string",
      },
    });
    await insertMultiple(db, data);

    function highlight(element: HTMLElement, value: string, terms: string[]) {
      const pattern = terms
        .map(term => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
        .join("|");
      if (!pattern) {
        element.textContent = value;
        return;
      }
      const regex = new RegExp(pattern, "gi");
      let last = 0;
      for (const match of value.matchAll(regex)) {
        const index = match.index;
        element.append(document.createTextNode(value.slice(last, index)));
        const mark = document.createElement("mark");
        mark.textContent = match[0];
        element.append(mark);
        last = index + match[0].length;
      }
      element.append(document.createTextNode(value.slice(last)));
    }

    let request = 0;
    async function update() {
      const currentRequest = ++request;
      const term = input.value.trim();
      const params = new URLSearchParams(location.search);
      if (term) params.set("q", term);
      else params.delete("q");
      const query = params.toString();
      history.replaceState(
        history.state,
        "",
        location.pathname + (query ? `?${query}` : "") + location.hash
      );
      sessionStorage.setItem(
        "backUrl",
        (root!.dataset.backurl || location.pathname) +
          (query ? `?${query}` : "")
      );
      results.replaceChildren();
      clear.hidden = !input.value;
      if (!term) {
        status.textContent = "A few articles to get you started";
        for (const doc of data.slice(0, 3)) renderResult(doc, []);
        return;
      }
      const found = await search(db, {
        term,
        properties: ["title", "description", "body"],
        boost: { title: 3, description: 2 },
        limit: data.length,
      });
      if (currentRequest !== request) return;
      status.textContent = `${found.count} ${found.count === 1 ? "result" : "results"}`;
      const terms = term.match(/[\p{L}\p{N}]+/gu) ?? [];
      for (const hit of found.hits) renderResult(hit.document, terms);
    }

    function renderResult(doc: (typeof data)[number], terms: string[]) {
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = doc.url;
      link.className = "search-result-title";
      highlight(link, doc.title, terms);
      const excerpt = document.createElement("p");
      excerpt.className = "search-result-excerpt";
      const lower = doc.body.toLowerCase();
      const positions = terms
        .map(word => lower.indexOf(word.toLowerCase()))
        .filter(index => index >= 0);
      const start = positions.length
        ? Math.max(0, Math.min(...positions) - 90)
        : 0;
      const text = positions.length
        ? doc.body.slice(start, start + 220)
        : doc.description;
      highlight(
        excerpt,
        (start ? "…" : "") +
          text +
          (positions.length && start + 220 < doc.body.length ? "…" : ""),
        terms
      );
      const meta = document.createElement("p");
      meta.className = "search-result-meta";
      meta.textContent = doc.meta;
      item.append(link, excerpt, meta);
      results.append(item);
    }

    input.value = new URLSearchParams(location.search).get("q") || "";
    input.addEventListener("input", update);
    clear.addEventListener("click", () => {
      input.value = "";
      input.focus();
      update();
    });
    update();
  }
  document.addEventListener("astro:after-swap", initSearch);
  initSearch();
</script>
<style is:global>
  #orama-search {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--background) 96%, var(--accent) 4%);
    box-shadow: 0 12px 36px
      color-mix(in srgb, var(--foreground) 7%, transparent);
    overflow: hidden;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .search-field:focus-within {
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .search-icon {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    color: var(--foreground);
  }
  #search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--foreground);
    font: inherit;
    font-size: 1.1rem;
  }
  #search-input::placeholder {
    color: var(--muted-foreground);
    opacity: 1;
  }
  #search-input::-webkit-search-cancel-button {
    display: none;
  }
  #search-clear {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--foreground);
  }
  #search-clear[hidden] {
    display: none;
  }
  #search-clear:hover {
    background: var(--muted);
  }
  #search-clear svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .search-content {
    padding: 1.5rem;
  }
  #search-status {
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }
  #search-results {
    overflow-wrap: anywhere;
  }
  #search-results li {
    padding-top: 1.75rem;
  }
  #search-results li + li {
    margin-top: 0.5rem;
  }
  .search-result-title {
    color: var(--accent);
    font-family: Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
  }
  .search-result-title:hover {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .search-result-excerpt {
    margin-top: 0.65rem;
    line-height: 1.65;
  }
  .search-result-meta {
    margin-top: 0.6rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }
  .search-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.8rem;
  }
  .search-footer a {
    color: var(--accent);
  }
  .search-footer a:hover {
    text-decoration: underline;
  }
  #orama-search mark {
    background: #fde68a;
    color: #1c1917;
    border-radius: 0.15rem;
  }
  @media (max-width: 400px) {
    .search-field,
    .search-content,
    .search-footer {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .search-field {
      gap: 0.65rem;
    }
    #search-input {
      font-size: 1rem;
    }
  }
</style>
